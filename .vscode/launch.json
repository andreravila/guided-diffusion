{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--large_size",
                "128",
                "--small_size",
                "128",
                "--diffusion_steps",
                "2000"
            ]
        },
        {
            "name": "Python Train Debug",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "presentation": {
                "focus": true
            },
            "connect": {
                "host": "localhost",
                "port": "6502"
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "/home/test"
                }
            ],
            "preLaunchTask": "run-container-train-debug"
        },
        {
            "name": "Python Train Classifier Debug",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "presentation": {
                "focus": true
            },
            "connect": {
                "host": "localhost",
                "port": "6502"
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "/home/test"
                }
            ],
            "preLaunchTask": "run-container-train-classifier-debug"
        },
        {
            "name": "Python Sample Debug",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "presentation": {
                "focus": true
            },
            "connect": {
                "host": "localhost",
                "port": "6502"
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "/home/test"
                }
            ],
            "preLaunchTask": "run-container-sample-debug"
        },
        {
            "name": "Python Sample Classifier Debug",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "presentation": {
                "focus": true
            },
            "connect": {
                "host": "localhost",
                "port": "6502"
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "/home/test"
                }
            ],
            "preLaunchTask": "run-container-sample-classifier-debug"
        },
    ]
}