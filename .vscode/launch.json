{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--large_size",
                "128",
                "--small_size",
                "128",
                "--diffusion_steps",
                "2000"
            ]
        },
        {
            "name": "Python Debug",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "localhost",
                "port": "6502"
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "/home/test"
                }
            ],
            "preLaunchTask": "run-debug-container"
        },
        {
            "name": "Python Production",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "6502",
                "port": "6502"
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "/home/test"
                }
            ],
            "preLaunchTask": "run-production-container"
        }
    ]
}